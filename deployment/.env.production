# KifPilot AI Support Agent - Production Environment
# Copy this file to .env.production and customize for your production environment

# Application
APP_ENV=production
APP_NAME=KifPilot AI Support Agent
VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database (SQLite with volume persistence)
DATABASE_URL=sqlite+aiosqlite:///app/data/kifpilot.db

# Vector Store
CHROMA_PERSIST_DIR=/app/chroma_db

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_MIN_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# CORS - Update with your production domain
CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Document Ingestion
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".txt", ".md"]
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
UPLOAD_DIR=/app/uploads

# Retrieval
RETRIEVAL_MIN_SCORE=0.3
RETRIEVAL_MAX_CONTEXT=8000

# Hybrid Search
HYBRID_RRF_K=60

# Cross-Encoder Re-ranker
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL_CACHE_DIR=
RERANKER_MAX_CANDIDATES=20
RERANKER_MAX_RESULTS=5
RERANKER_TIMEOUT_SECONDS=5.0
RERANKER_BATCH_SIZE=16
RERANKER_MIN_RERANK_SCORE=0.0

# Query Expansion
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_QUERIES=5
QUERY_EXPANSION_TIMEOUT_SECONDS=2.0
QUERY_EXPANSION_USE_LLM=false
QUERY_EXPANSION_LLM_MAX_EXPANSIONS=3
QUERY_EXPANSION_LLM_TIMEOUT_SECONDS=3.0
QUERY_EXPANSION_CACHE_ENABLED=true
QUERY_EXPANSION_CACHE_TTL_SECONDS=3600

# Context Compression
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_COMPRESSION_MAX_TOKENS=8000
CONTEXT_COMPRESSION_MAX_DOCUMENTS=20
CONTEXT_COMPRESSION_MAX_CHUNKS=50

# Monitoring (optional)
# PROMETHEUS_METRICS_ENABLED=true
# PROMETHEUS_PORT=9090